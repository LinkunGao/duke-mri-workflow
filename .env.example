# Copy this file to .env and fill in your own locations.
#   cp .env.example .env
#
# .env is gitignored. Never put real paths or case identifiers in tracked files.
# Every variable is optional -- you only need the ones for the workflow you run,
# and anything you leave unset can still be passed on the command line.
#
# Not sure how your DICOM is organised? Start here, it converts nothing:
#   python main.py --discover /path/to/dicom_root


# --- volunteer: one series folder per case, found by a path template ----------
# Substituted for {root} in the template below.
DICOM_ROOT_VOLUNTEER=/path/to/volunteer/images
# {root} and {case} are filled in per case. Change it to match your own layout,
# or override per run with --template.
SERIES_TEMPLATE_VOLUNTEER={root}/{case}/MRI_T2_prone
# Comma-separated. Overridden by --cases.
CASES_VOLUNTEER=00001,00002,00003


# --- adhb: series folders listed in a manifest json ---------------------------
# Generate one with --discover, or write it by hand following
# data/example_manifest.json.
MANIFEST_PATH_ADHB=data/manifest_adhb.json
# Leave empty to run every case in the manifest.
CASES_ADHB=


# --- ea: EA1141-style tree, series identified from the DICOM headers ----------
# Root directory holding one folder per subject.
DICOM_ROOT_EA=/path/to/EA1141
CASES_EA=SUBJECT-0001
